<Window x:Class="FolderTools.FlattenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderTools"
        Icon="Assets/FolderTools.ico"
        Width="1000" Height="700" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="24,20,24,20">
    <local:UpdateBar DockPanel.Dock="Top" Margin="0,0,0,12" />

    <!-- Title and folder. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Click="Settings_Click" Padding="8" VerticalAlignment="Top"
              ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}">
        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="14" />
      </Button>
      <StackPanel>
        <TextBlock Text="{local:Tr ActionFlatten}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Depth (chosen here, the last choice is kept) and the naming of Settings → Flatten. -->
    <Grid x:Name="Options" DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{local:Tr FlattenDepth}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
        <ComboBox x:Name="DepthBox" HorizontalAlignment="Stretch" SelectionChanged="DepthBox_SelectionChanged"
                  AutomationProperties.Name="{local:Tr FlattenDepth}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{local:Tr FlattenNaming}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
          <Run x:Name="NamingRun" />
          <Hyperlink Click="Settings_Click"><Run Text="{local:Tr CleanChangeMode}" /></Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Buttons. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{local:Tr Close}" Click="Close_Click" MinWidth="96"
              Margin="8,0,0,0" IsCancel="True" />
      <Button x:Name="FlattenButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" MinWidth="120"
              Click="Flatten_Click" />
      <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Click="OpenFolder_Click" Margin="0,0,8,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0" />
          <TextBlock Text="{local:Tr PhotosOpenFolder}" />
        </StackPanel>
      </Button>
      <Button x:Name="UndoButton" DockPanel.Dock="Right" Click="Undo_Click" Margin="0,0,8,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" Margin="0,0,8,0" />
          <TextBlock Text="{local:Tr FlattenUndo}" />
        </StackPanel>
      </Button>
    </DockPanel>

    <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
               Text="{local:Tr FlattenNote}" />

    <!-- Summary and progress. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
      <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="1" />
    </StackPanel>

    <!-- Files of the same name and the same content: keep one (checked) or both. -->
    <Border x:Name="IdenticalBar" DockPanel.Dock="Top" Style="{StaticResource WarningBar}" Margin="0,0,0,8" Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontWeight="SemiBold">
          <Run FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" /> <Run Text="{local:Tr FlattenIdenticalTitle}" />
        </TextBlock>
        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
          <ItemsControl x:Name="IdenticalList" ItemsSource="{Binding Identical, RelativeSource={RelativeSource AncestorType=Window}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2" ToolTip="{Binding ToolTip}"
                          AutomationProperties.Name="{Binding Name}">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                  </TextBlock>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Style="{StaticResource SecondaryText}" Text="{local:Tr FlattenIdenticalNote}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Preview: each file with its new name and where it comes from; after: the files that could not move first. -->
    <ListView x:Name="Preview" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              AutomationProperties.Name="{local:Tr ActionFlatten}">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{local:Tr FlattenColumnName}" Width="460">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding ToolTip}" Margin="6,0,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="15" Margin="0,0,8,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{local:Tr FlattenColumnFrom}" Width="380">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding From}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
