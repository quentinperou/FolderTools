<Window x:Class="FolderTools.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderTools"
        Icon="Assets/FolderTools.ico"
        Width="1100" Height="740" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style x:Key="NumberCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="24,20,24,20">
    <local:UpdateBar DockPanel.Dock="Top" Margin="0,0,0,12" />

    <!-- Title and folder. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Click="Settings_Click" Padding="8" VerticalAlignment="Top"
              ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}">
        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="14" />
      </Button>
      <StackPanel>
        <TextBlock Text="{local:Tr ActionDuplicates}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Buttons. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{local:Tr Close}" Click="Close_Click" MinWidth="96"
              Margin="8,0,0,0" IsCancel="True" />
      <Button x:Name="RecycleButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" MinWidth="120"
              Click="Recycle_Click" />
      <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{local:Tr Cancel}" Click="Cancel_Click" MinWidth="96"
              Margin="0,0,8,0" />
      <Button x:Name="RescanButton" DockPanel.Dock="Right" Click="Rescan_Click" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0" />
          <TextBlock Text="{local:Tr CleanRescan}" />
        </StackPanel>
      </Button>
    </DockPanel>

    <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
               Text="{local:Tr DuplicatesNote}" />

    <!-- Summary and progress. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
      <TextBlock x:Name="KeepText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
        <Run x:Name="KeepRun" />
        <Hyperlink Click="Settings_Click"><Run Text="{local:Tr CleanChangeMode}" /></Hyperlink>
      </TextBlock>
      <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="1" />
    </StackPanel>

    <!-- The groups of duplicates, the heaviest first; checked copies go to the recycle bin. -->
    <ListView x:Name="List" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
              VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{local:Tr ActionDuplicates}"
              MouseDoubleClick="List_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Margin="0,2" Padding="0"
                              AutomationProperties.Name="{Binding Name.Title}">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="8,6,0,6">
                          <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,0,8,0" />
                          <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Name.Detail}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Expander.Header>
                      <ItemsPresenter />
                    </Expander>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </ListView.GroupStyle>

      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{local:Tr MenuOpen}" Click="Open_Click">
            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{local:Tr MenuShowInExplorer}" Click="ShowInExplorer_Click">
            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE838;" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{local:Tr MenuCopyPath}" Click="CopyPath_Click">
            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </ListView.ContextMenu>

      <ListView.View>
        <GridView>
          <GridViewColumn Width="44">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Margin="4,0,0,0" ToolTip="{local:Tr DuplicatesCheckToolTip}"
                          AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{local:Tr ColumnName}" Width="330">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Path}">
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE7C3;" FontSize="15" Margin="0,0,8,0"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{local:Tr ColumnFolder}" Width="330">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{local:Tr ColumnModified}" Width="165">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource NumberCell}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{local:Tr ColumnSize}" Width="100">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding SizeText}" Style="{StaticResource NumberCell}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
