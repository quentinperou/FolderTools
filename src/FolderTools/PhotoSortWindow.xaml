<Window x:Class="FolderTools.PhotoSortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderTools"
        Icon="Assets/FolderTools.ico"
        Width="900" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="24,20,24,20">
    <local:UpdateBar DockPanel.Dock="Top" Margin="0,0,0,12" />

    <!-- Title and folder. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Click="Settings_Click" Padding="8" VerticalAlignment="Top"
              ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}">
        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="14" />
      </Button>
      <StackPanel>
        <TextBlock Text="{local:Tr ActionPhotos}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- The two choices of Settings → Photos, changeable here (the last choice is kept). -->
    <Grid x:Name="Options" DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{local:Tr PhotosLayout}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
        <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" SelectionChanged="Options_SelectionChanged"
                  AutomationProperties.Name="{local:Tr PhotosLayout}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{local:Tr PhotosUndated}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
        <ComboBox x:Name="UndatedBox" HorizontalAlignment="Stretch" SelectionChanged="Options_SelectionChanged"
                  AutomationProperties.Name="{local:Tr PhotosUndated}" />
      </StackPanel>
    </Grid>

    <!-- Buttons. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{local:Tr Close}" Click="Close_Click" MinWidth="96"
              Margin="8,0,0,0" IsCancel="True" />
      <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" MinWidth="120"
              Click="Sort_Click" />
      <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Click="OpenFolder_Click" Margin="0,0,8,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0" />
          <TextBlock Text="{local:Tr PhotosOpenFolder}" />
        </StackPanel>
      </Button>
      <Button x:Name="UndoButton" DockPanel.Dock="Right" Click="Undo_Click" Margin="0,0,8,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" Margin="0,0,8,0" />
          <TextBlock Text="{local:Tr PhotosUndo}" />
        </StackPanel>
      </Button>
    </DockPanel>

    <TextBlock x:Name="RenameNote" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
               Text="{local:Tr PhotosRenameNote}" />

    <!-- Summary and progress. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
      <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="1" />
    </StackPanel>

    <!-- Preview: the date folders and what goes in them; after a sort, the files that could not move. -->
    <TreeView x:Name="Preview" ItemsSource="{Binding Nodes, RelativeSource={RelativeSource AncestorType=Window}}"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              AutomationProperties.Name="{local:Tr ActionPhotos}">
      <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <!-- The detail right after the name: a column on the right would not line up across the levels. -->
          <DockPanel ToolTip="{Binding ToolTip}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="15" Margin="0,0,8,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</Window>
