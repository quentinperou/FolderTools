<Window x:Class="FolderTools.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderTools"
        Title="{local:Tr Settings}"
        Width="880" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A settings row, like the cards of the Windows 11 Settings app. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Rows under the first one of a card, aligned with its title (16 padding + 20 icon + 16 margin). -->
    <Style x:Key="CardSubRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="52,12,16,12" />
    </Style>

    <Style x:Key="CardDivider" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Windows 11 toggle switch: the Fluent theme has its brushes but no style for it. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}">
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page of the menu on the left, like the navigation of the Windows 11 Settings app (and PageCompose). -->
    <Style x:Key="MenuItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Back" CornerRadius="4" Background="Transparent" Padding="12,9">
              <Grid>
                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                        HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="Hidden" />
                <ContentPresenter />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pages share one grid cell; hidden ones stay Hidden (not Collapsed) so the window keeps the height of the tallest. -->
    <Style x:Key="Page" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Visibility" Value="Hidden" />
    </Style>
  </Window.Resources>

  <Grid Margin="16,20,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Column="0" Text="{local:Tr Settings}" FontSize="24" FontWeight="SemiBold" Margin="8,0,0,16" />
    <TextBlock Grid.Column="1" x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" Margin="16,4,0,16"
               VerticalAlignment="Center" />

    <ListBox x:Name="PageList" Grid.Row="1" Grid.RowSpan="2" Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource MenuItem}" SelectionChanged="PageList_SelectionChanged"
             AutomationProperties.Name="{local:Tr Settings}">
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsGeneral}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE713;" />
          <TextBlock Text="{local:Tr SettingsGeneral}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsEmptyFolders}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;" />
          <TextBlock Text="{local:Tr SettingsEmptyFolders}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsPhotos}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE91B;" />
          <TextBlock Text="{local:Tr SettingsPhotos}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsFlatten}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74A;" />
          <TextBlock Text="{local:Tr SettingsFlatten}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsDuplicates}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;" />
          <TextBlock Text="{local:Tr SettingsDuplicates}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr UpdatesTitle}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE895;" />
          <TextBlock Text="{local:Tr UpdatesTitle}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{local:Tr SettingsAbout}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;" />
          <TextBlock Text="{local:Tr SettingsAbout}" VerticalAlignment="Center" />
        </StackPanel>
      </ListBoxItem>
    </ListBox>

    <!-- General: language, theme, Windows 11 context menu. -->
    <ScrollViewer x:Name="GeneralPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE774;" />
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="LanguageBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr SettingsLanguage}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr SettingsLanguage}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsLanguageDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE790;" />
            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="ThemeBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr SettingsTheme}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr SettingsTheme}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsThemeDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- "FolderTools ›" in the new Windows 11 context menu, then each of its entries (always all under
             "Show more options"). -->
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <DockPanel Margin="16,14">
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8B7;" />
              <CheckBox x:Name="NewMenuBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Checked="NewMenu_Changed" Unchecked="NewMenu_Changed"
                        AutomationProperties.Name="{local:Tr SettingsNewMenu}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr SettingsNewMenu}" />
                <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsNewMenuDescription}" />
              </StackPanel>
            </DockPanel>

            <StackPanel x:Name="MenuEntries">
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="SizeEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionSize}" />
                <TextBlock Text="{local:Tr ActionSize}" VerticalAlignment="Center" />
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="CleanEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionClean}" />
                <TextBlock Text="{local:Tr ActionClean}" VerticalAlignment="Center" />
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="PhotosEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionPhotos}" />
                <TextBlock Text="{local:Tr ActionPhotos}" VerticalAlignment="Center" />
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="FlattenEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionFlatten}" />
                <TextBlock Text="{local:Tr ActionFlatten}" VerticalAlignment="Center" />
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="DuplicatesEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionDuplicates}" />
                <TextBlock Text="{local:Tr ActionDuplicates}" VerticalAlignment="Center" />
              </DockPanel>
              <Rectangle Style="{StaticResource CardDivider}" />
              <DockPanel Style="{StaticResource CardSubRow}">
                <CheckBox x:Name="ColorEntryBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="MenuEntry_Changed" Unchecked="MenuEntry_Changed"
                          AutomationProperties.Name="{local:Tr ActionColor}" />
                <TextBlock Text="{local:Tr ActionColor}" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Empty folders: recycle bin or deleted for good, then the files that do not count. -->
    <ScrollViewer x:Name="EmptyFoldersPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE74D;" />
            <ComboBox x:Name="DeleteModeBox" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="DeleteModeBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr SettingsDeleteMode}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr SettingsDeleteMode}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsDeleteModeDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8A5;" VerticalAlignment="Top" />
            <TextBox x:Name="IgnoredFilesBox" DockPanel.Dock="Right" Width="220" Height="110" Margin="16,0,0,0"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     LostFocus="IgnoredFiles_LostFocus" AutomationProperties.Name="{local:Tr SettingsIgnoredFiles}" />
            <StackPanel>
              <TextBlock Text="{local:Tr SettingsIgnoredFiles}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsIgnoredFilesDescription}" />
              <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0">
                <Hyperlink Click="ResetIgnoredFiles_Click"><Run Text="{local:Tr SettingsIgnoredFilesReset}" /></Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Folders never looked into nor deleted (.git...). -->
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE72E;" VerticalAlignment="Top" />
            <TextBox x:Name="IgnoredFoldersBox" DockPanel.Dock="Right" Width="220" Height="88" Margin="16,0,0,0"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     LostFocus="IgnoredFiles_LostFocus" AutomationProperties.Name="{local:Tr SettingsIgnoredFolders}" />
            <StackPanel>
              <TextBlock Text="{local:Tr SettingsIgnoredFolders}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsIgnoredFoldersDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Photos: the date folders, and what to do with photos that have no date taken. -->
    <ScrollViewer x:Name="PhotosPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE787;" />
            <ComboBox x:Name="PhotoLayoutBox" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="PhotoOptions_SelectionChanged"
                      AutomationProperties.Name="{local:Tr PhotosLayout}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr PhotosLayout}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsPhotosLayoutDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE9CE;" />
            <ComboBox x:Name="PhotoUndatedBox" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="PhotoOptions_SelectionChanged"
                      AutomationProperties.Name="{local:Tr PhotosUndated}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr PhotosUndated}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsPhotosUndatedDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Flatten: what a name already taken becomes. -->
    <ScrollViewer x:Name="FlattenPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8AC;" />
            <ComboBox x:Name="FlattenNamingBox" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="FlattenNamingBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr FlattenNaming}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr FlattenNaming}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsFlattenNamingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Duplicates: the copy kept by default. -->
    <ScrollViewer x:Name="DuplicatesPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE8C8;" />
            <ComboBox x:Name="DuplicateKeepBox" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="DuplicateKeepBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr DuplicatesKeep}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr DuplicatesKeep}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr SettingsDuplicatesKeepDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Updates: status and check/install button, then the startup check and the channel. -->
    <ScrollViewer x:Name="UpdatesPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="16,14">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE895;" />
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                    Margin="16,0,0,0" Click="UpdateButton_Click" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr UpdatesTitle}" />
              <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CardDescription}" />
              <TextBlock x:Name="UpdateNotesLink" Style="{StaticResource CardDescription}" Visibility="Collapsed">
                <Hyperlink Click="UpdateNotes_Click"><Run Text="{local:Tr UpdateWhatsNew}" /></Hyperlink>
              </TextBlock>
              <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,8,0,2" Visibility="Collapsed" />
            </StackPanel>
          </DockPanel>

          <Rectangle Style="{StaticResource CardDivider}" />
          <DockPanel Style="{StaticResource CardSubRow}">
            <CheckBox x:Name="CheckAtStartupBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                      VerticalAlignment="Center" Margin="16,0,0,0"
                      Checked="CheckAtStartup_Changed" Unchecked="CheckAtStartup_Changed"
                      AutomationProperties.Name="{local:Tr UpdateCheckAtStartup}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr UpdateCheckAtStartup}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr UpdateCheckAtStartupDescription}" />
            </StackPanel>
          </DockPanel>

          <Rectangle Style="{StaticResource CardDivider}" />
          <DockPanel Style="{StaticResource CardSubRow}">
            <ComboBox x:Name="ChannelBox" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                      Margin="16,0,0,0" SelectionChanged="ChannelBox_SelectionChanged"
                      AutomationProperties.Name="{local:Tr UpdateChannel}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:Tr UpdateChannel}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{local:Tr UpdateChannelDescription}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- About. -->
    <ScrollViewer x:Name="AboutPage" Grid.Row="1" Grid.Column="1" Style="{StaticResource Page}" Margin="16,0,0,0">
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="Assets/FolderTools.png" RenderOptions.BitmapScalingMode="HighQuality" Width="40" Height="40" Margin="0,0,16,0"
                 VerticalAlignment="Top" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{local:Tr AppTitle}" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
            <TextBlock Style="{StaticResource CardDescription}">
              <Run Text="{local:Tr AboutDevelopedBy}" /><Hyperlink NavigateUri="https://github.com/quentinperou"
                  RequestNavigate="Link_RequestNavigate">QuentinPerou</Hyperlink>
            </TextBlock>
            <TextBlock Style="{StaticResource CardDescription}">
              <Hyperlink NavigateUri="https://github.com/quentinperou/FolderTools" RequestNavigate="Link_RequestNavigate"><Run
                  Text="{local:Tr AboutSourceCode}" /></Hyperlink>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </ScrollViewer>

    <Button Grid.Row="2" Grid.Column="1" Content="{local:Tr Close}" HorizontalAlignment="Right" MinWidth="96"
            Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
  </Grid>
</Window>
