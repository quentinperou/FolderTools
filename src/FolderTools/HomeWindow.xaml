<Window x:Class="FolderTools.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderTools"
        Title="{local:Tr AppTitle}" Icon="Assets/FolderTools.ico"
        Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">

  <StackPanel Margin="24,20,24,24">
    <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Click="Settings_Click" VerticalAlignment="Center" Padding="8"
              ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}">
        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="16" />
      </Button>
      <Image Source="Assets/FolderTools.png" RenderOptions.BitmapScalingMode="HighQuality" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{local:Tr AppTitle}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{local:Tr HomeSubtitle}" Style="{StaticResource SecondaryText}" />
      </StackPanel>
    </DockPanel>

    <!-- New version available (startup check). -->
    <!-- New version available (startup check): install from here. -->
    <local:UpdateBar Margin="0,0,0,12" />

    <TextBlock Text="{local:Tr HomeFolder}" Margin="0,0,0,6" />
    <DockPanel Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Content="{local:Tr Browse}" Click="Browse_Click" Margin="8,0,0,0" MinWidth="96" />
      <TextBox x:Name="PathBox" VerticalContentAlignment="Center" TextChanged="PathBox_TextChanged"
               AutomationProperties.Name="{local:Tr HomeFolder}" />
    </DockPanel>
    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,16">
      <Hyperlink Click="TempFolder_Click"><Run Text="{local:Tr HomeTempFolder}" /></Hyperlink>
      <Run Text="·" />
      <Run Text="{local:Tr HomeDropHint}" />
    </TextBlock>

    <Button x:Name="SizeButton" Click="Size_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,0,0,4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE9D2;" FontSize="24" Margin="0,0,16,0" />
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
        <StackPanel>
          <TextBlock Text="{local:Tr ActionSize}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Tr ActionSizeDescription}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </DockPanel>
    </Button>

    <Button x:Name="CleanButton" Click="Clean_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="24" Margin="0,0,16,0" />
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
        <StackPanel>
          <TextBlock Text="{local:Tr ActionClean}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Tr ActionCleanDescription}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </DockPanel>
    </Button>

    <Button x:Name="PhotosButton" Click="Photos_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,4,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE91B;" FontSize="24" Margin="0,0,16,0" />
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
        <StackPanel>
          <TextBlock Text="{local:Tr ActionPhotos}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Tr ActionPhotosDescription}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </DockPanel>
    </Button>

    <Button x:Name="FlattenButton" Click="Flatten_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,4,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE74A;" FontSize="24" Margin="0,0,16,0" />
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
        <StackPanel>
          <TextBlock Text="{local:Tr ActionFlatten}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Tr ActionFlattenDescription}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </DockPanel>
    </Button>

    <Button x:Name="DuplicatesButton" Click="Duplicates_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,4,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="24" Margin="0,0,16,0" />
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
        <StackPanel>
          <TextBlock Text="{local:Tr ActionDuplicates}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Tr ActionDuplicatesDescription}" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </DockPanel>
    </Button>

    <TextBlock Text="{local:Tr HomeContextMenuHint}" Style="{StaticResource SecondaryText}" Margin="0,16,0,0" />
  </StackPanel>
</Window>
