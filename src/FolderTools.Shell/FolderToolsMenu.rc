// Context menu labels, in each supported language. Windows picks the table matching the user's display
// language (or its parent, e.g. fr-CA -> fr), then falls back to the user/system UI language and finally
// to US English. Do not mark a table LANG_NEUTRAL: the loader would pick it first, whatever the language.
// "FolderTools" is the app's name: it is not translated.
#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

// Any English variant (en-GB, en-CA...).
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    IDS_MENU_TITLE "FolderTools"
    IDS_MENU_SIZE "Folder sizes"
    IDS_MENU_CLEAN "Delete empty folders"
    IDS_MENU_COLOR "Folder color"
    IDS_MENU_PHOTOS "Sort photos by date"
    IDS_COLOR_RED "Red"
    IDS_COLOR_ORANGE "Orange"
    IDS_COLOR_YELLOW "Yellow"
    IDS_COLOR_GREEN "Green"
    IDS_COLOR_BLUE "Blue"
    IDS_COLOR_PURPLE "Purple"
    IDS_COLOR_PINK "Pink"
    IDS_COLOR_GRAY "Gray"
    IDS_COLOR_DEFAULT "Default color"
END

// US English is the loader's last-resort fallback for languages without a table here.
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_MENU_TITLE "FolderTools"
    IDS_MENU_SIZE "Folder sizes"
    IDS_MENU_CLEAN "Delete empty folders"
    IDS_MENU_COLOR "Folder color"
    IDS_MENU_PHOTOS "Sort photos by date"
    IDS_COLOR_RED "Red"
    IDS_COLOR_ORANGE "Orange"
    IDS_COLOR_YELLOW "Yellow"
    IDS_COLOR_GREEN "Green"
    IDS_COLOR_BLUE "Blue"
    IDS_COLOR_PURPLE "Purple"
    IDS_COLOR_PINK "Pink"
    IDS_COLOR_GRAY "Gray"
    IDS_COLOR_DEFAULT "Default color"
END

LANGUAGE LANG_FRENCH, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    IDS_MENU_TITLE "FolderTools"
    IDS_MENU_SIZE "Taille des dossiers"
    IDS_MENU_CLEAN "Supprimer les dossiers vides"
    IDS_MENU_COLOR "Couleur du dossier"
    IDS_MENU_PHOTOS "Trier les photos par date"
    IDS_COLOR_RED "Rouge"
    IDS_COLOR_ORANGE "Orange"
    IDS_COLOR_YELLOW "Jaune"
    IDS_COLOR_GREEN "Vert"
    IDS_COLOR_BLUE "Bleu"
    IDS_COLOR_PURPLE "Violet"
    IDS_COLOR_PINK "Rose"
    IDS_COLOR_GRAY "Gris"
    IDS_COLOR_DEFAULT "Couleur par défaut"
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_MENU_SIZE ICON "SizeMenu.ico"
IDI_MENU_CLEAN ICON "CleanMenu.ico"
IDI_MENU_COLOR ICON "ColorMenu.ico"
IDI_MENU_PHOTOS ICON "PhotosMenu.ico"
