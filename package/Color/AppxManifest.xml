<?xml version="1.0" encoding="utf-8"?>
<!--
  Second "sparse" package of FolderTools: "Folder color ›" (colors as sub-entries) in the NEW File Explorer context
  menu, on folders. Separate from package\AppxManifest.xml on purpose: one verb per package, otherwise Windows
  gathers the verbs of a package in a flyout named after it, without icon. Same external location (the install
  folder) and same DLL (FolderToolsMenu.dll, class FolderColorCommand). Registered by the installer like the other:
    Add-AppxPackage -Path FolderTools.ColorMenu.msix -ExternalLocation <install folder> -AllowUnsigned
  Only bump Version when this file changes.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 desktop6 com rescap">

  <Identity
    Name="FolderTools.ColorMenu"
    Publisher="CN=FolderTools, OID.2.25.311729368913984317654407730594956997722=1"
    Version="1.1.0.0"
    ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>FolderTools (folder color)</DisplayName>
    <PublisherDisplayName>QuentinPerou</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
    <!-- The menu DLL reads HKCU\Software\FolderTools (written by the app, which has no package identity). With
         registry virtualization on, a packaged process does not see keys created outside the package. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="FolderToolsColor" Executable="FolderTools.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="FolderTools"
        Description="Folder colors from the File Explorer context menu"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- The menu entry: on a folder and on the background of an open folder ("Drive" is not an allowed type
             here; drives have the classic entry, registered by the installer). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="FolderColor" Clsid="07A048EB-4FAE-4897-A619-4E4DA25C1376" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- The COM class behind it: FolderToolsMenu.dll (src/FolderTools.Shell), loaded in a surrogate process. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="FolderTools folder color menu">
              <com:Class Id="07A048EB-4FAE-4897-A619-4E4DA25C1376" Path="FolderToolsMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
